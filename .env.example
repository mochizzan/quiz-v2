# Copy to .env and fill every empty value before `docker compose up`.
# .env is git-ignored; compose reads it for both interpolation and env_file, so
# no deployment value is stored in docker-compose.yml.
#
# The deployment stops on the first problem:
#   - SESSION_SIGNING_KEY empty or shorter than 32 bytes -> server refuses to start
#   - BOOTSTRAP_TEACHER_* empty -> the migrate service exits non-zero and the
#     app never starts, because a deployment with no teacher account is unusable
#   - the seeded account is not a live teacher afterwards -> same hard stop

APP_ADDR=:8080
UPLOADS_DIR=/app/uploads
COOKIE_SECURE=false

# Must match MARIADB_USER / MARIADB_PASSWORD / MARIADB_DATABASE below. parseTime,
# loc=UTC and the absence of multiStatements are enforced at startup (OPS-233).
DB_DSN=quiz:quiz@tcp(db:3306)/quiz?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci&loc=UTC&timeout=5s&readTimeout=10s&writeTimeout=10s

# At least 32 random bytes. Generate with: openssl rand -hex 32
SESSION_SIGNING_KEY=

# The first teacher. bootstrap-teacher hashes BOOTSTRAP_TEACHER_PASSWORD here,
# so no bcrypt value has to be produced by hand. The password must satisfy the
# login policy: 8+ characters, at least one uppercase letter and one digit.
# Re-running with the same email is a no-op, not an error.
BOOTSTRAP_TEACHER_NAME=
BOOTSTRAP_TEACHER_EMAIL=
BOOTSTRAP_TEACHER_PASSWORD=

# MariaDB container bootstrap. These only take effect on an empty dbdata volume;
# changing them later does not alter an existing database.
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=quiz
MARIADB_USER=quiz
MARIADB_PASSWORD=
